# Clean, reproducible relink of broadcast_perf onto the canonical GIN Anvil-SDMA image.
#
# Rationale: a from-scratch `docker-gin-gda-sdma-build.bash` is heavy (it rebuilds
# rocSHMEM + RCCL from source) and can be blocked by Docker Hub's anonymous pull
# rate limit on `FROM ubuntu:24.04`. Since RCCL and rocSHMEM are unchanged and only
# the rccl-tests Broadcast source changed, this stage recompiles just rccl-tests
# from the updated source using the exact cmake config already baked into
# /workspace/rccl-tests. This is Dockerfile-based (reproducible), not a
# `docker commit` of an interactive container. Build context = repo root.
#
#   docker build -f ddai-artifacts/docker/Dockerfile-rccl-gin-gda-sdma-bcast-relink \
#       -t rccl-gin-gda-sdma-713:latest .
ARG BASE_IMAGE=rccl-gin-gda-sdma-713:latest
FROM ${BASE_IMAGE}

# Overlay rccl-tests sources the wip CMakeLists.txt and broadcast -D 3 path need.
# common.cu/h carry devtimeAugmentLine + testStreamSynchronize used by gin_sdma_devtime.h;
# do NOT COPY common.h into hipify/ (hipify regenerates it from source).
# gin_sdma_allgather_policy.h is listed in CMakeLists COMMON_FILES even though only
# broadcast_perf is relinked.
COPY projects/rccl-tests/src/broadcast.cu /workspace/rccl/src/projects/rccl-tests/src/broadcast.cu
COPY projects/rccl-tests/src/common.cu /workspace/rccl/src/projects/rccl-tests/src/common.cu
COPY projects/rccl-tests/src/common.h /workspace/rccl/src/projects/rccl-tests/src/common.h
COPY projects/rccl-tests/src/gin_sdma_broadcast_policy.h /workspace/rccl/src/projects/rccl-tests/src/gin_sdma_broadcast_policy.h
COPY projects/rccl-tests/src/gin_sdma_allgather_policy.h /workspace/rccl/src/projects/rccl-tests/src/gin_sdma_allgather_policy.h
COPY projects/rccl-tests/src/gin_sdma_devtime.h /workspace/rccl/src/projects/rccl-tests/src/gin_sdma_devtime.h
COPY projects/rccl-tests/src/gin_sdma_devtime_host.h /workspace/rccl/src/projects/rccl-tests/src/gin_sdma_devtime_host.h
COPY projects/rccl-tests/src/CMakeLists.txt /workspace/rccl/src/projects/rccl-tests/src/CMakeLists.txt
COPY projects/rccl-tests/src/gin_sdma_broadcast_policy.h /workspace/rccl-tests/src/hipify/gin_sdma_broadcast_policy.h
COPY projects/rccl-tests/src/gin_sdma_allgather_policy.h /workspace/rccl-tests/src/hipify/gin_sdma_allgather_policy.h
COPY projects/rccl-tests/src/gin_sdma_devtime.h /workspace/rccl-tests/src/hipify/gin_sdma_devtime.h
COPY projects/rccl-tests/src/gin_sdma_devtime_host.h /workspace/rccl-tests/src/hipify/gin_sdma_devtime_host.h

RUN set -eux; \
    grep -n "kBroadcastScatterAgMinDefault : v" /workspace/rccl/src/projects/rccl-tests/src/broadcast.cu; \
    grep -n "GinRingSmTableBroadcastKernel" /workspace/rccl/src/projects/rccl-tests/src/broadcast.cu; \
    cd /workspace/rccl-tests; \
    cmake . >/tmp/bcast_reconfigure.log 2>&1 || { tail -n 40 /tmp/bcast_reconfigure.log; exit 1; }; \
    make -j16 hipify broadcast_perf; \
    strings /workspace/rccl-tests/broadcast_perf | grep -cE 'ScatterAllgather|GinRingSmTableBroadcastKernel'
